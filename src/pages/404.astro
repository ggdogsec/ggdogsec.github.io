---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/paths';
---

<BaseLayout title="页面不存在" description="这个地址没有对应的页面。">
  <h1>页面不存在</h1>
  <p class="lede">没有找到这个地址。可以回到首页，或从六个合集里继续看。</p>
  <p>
    <a href={sitePath()}>首页</a>
    ·
    <a href={sitePath('heji')}>合集</a>
  </p>
</BaseLayout>
