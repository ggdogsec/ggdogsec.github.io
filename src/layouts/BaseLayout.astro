---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { site } from '../data/site';
import type { CategoryId } from '../data/categories';

interface Props {
  title?: string;
  description?: string;
  categoryId?: CategoryId;
}

const { title, description = site.description, categoryId } = Astro.props;
const pageTitle = title && title !== site.title ? `${title} · ${site.title}` : site.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('ggdogsec-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch (error) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteHeader categoryId={categoryId} />
    <div class="shell page-frame">
      <aside class="sidebar">
        <CategoryNav currentId={categoryId} />
      </aside>
      <main id="main">
        <slot />
      </main>
    </div>
    <SiteFooter />
    <script is:inline>
      (function () {
        var button = document.querySelector('[data-theme-toggle]');
        if (!button) return;

        function currentTheme() {
          var explicit = document.documentElement.dataset.theme;
          if (explicit === 'light' || explicit === 'dark') return explicit;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function paint() {
          var theme = currentTheme();
          var toDark = theme !== 'dark';
          button.textContent = toDark ? '深色' : '浅色';
          button.setAttribute('aria-label', toDark ? '切换到深色' : '切换到浅色');
          button.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
        }

        button.addEventListener('click', function () {
          var next = currentTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('ggdogsec-theme', next);
          } catch (error) {}
          paint();
        });

        paint();
      })();
    </script>
  </body>
</html>
