---
import type { Post } from '../lib/posts';
import { getCategory } from '../data/categories';
import { formatDate, isoDate } from '../lib/dates';
import { categoryPath, postPath } from '../lib/paths';

interface Props {
  posts: Post[];
  empty?: string;
  showCategory?: boolean;
  showOrder?: boolean;
}

const { posts, empty = '还没有正式文章。', showCategory = false, showOrder = false } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ol class="post-list">
      {posts.map((post) => {
        const category = getCategory(post.data.category);
        return (
          <li>
            {showOrder && <span class="post-kicker">合集第 {post.data.albumOrder} 篇</span>}
            <a class="title" href={postPath(post.id)}>
              {post.data.title}
            </a>
            {post.data.sample && <span class="badge">示例 · 可删除</span>}
            <span class="post-kicker">
              {showCategory && (
                <a href={categoryPath(category.id)}>{category.name}</a>
              )}
              {showCategory && ' · '}
              <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
            </span>
          </li>
        );
      })}
    </ol>
  )
}
